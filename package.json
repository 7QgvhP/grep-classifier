{
  "name": "c-grep-classifier",
  "displayName": "C-Grep Classifier",
  "description": "C言語の検索結果をデータフロー（入力・出力・定義）で分類して表示する拡張機能",
  "version": "3.1.4",






  "publisher": "developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/7QgvhP/c-grep-classifier.git"
  },

  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:c-grep-classifier.search",
    "onView:cGrepClassifierView"
  ],

  "contributes": {
    "configuration": {
      "title": "C-Grep Classifier",
      "properties": {
        "cGrepClassifier.includePattern": {
          "type": "string",
          "default": "**/*.{c,h}",
          "markdownDescription": "検索対象とするファイルのglobパターン。例: `**/*.{c,h,inc}`"
        },
        "cGrepClassifier.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**"
          ],
          "markdownDescription": "検索対象から除外するglobパターンの一覧。例: `**/build/**`"
        },
        "cGrepClassifier.useDefaultExcludes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "VS Code標準の除外設定（`#files.exclude#` および `#search.exclude#`）も併せて適用します。"
        },
        "cGrepClassifier.showEnclosingFunction": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "検索結果の各項目に、一致箇所が属する関数名を表示します。"
        },
        "cGrepClassifier.detailLevel": {
          "type": "string",
          "enum": [
            "category",
            "detailed"
          ],
          "enumDescriptions": [
            "「入力」「出力」「定義」などの大分類のみで表示します。",
            "大分類の下に「条件判定」「代入の右辺」などのサブ分類を追加して表示します。"
          ],
          "default": "category",
          "markdownDescription": "検索結果の分類の細かさを指定します。`detailed` にすると、使用されている文脈でさらに細分化して表示します。"
        }
      }
    },
    "languages": [
      {
        "id": "cgrep-result",
        "aliases": [
          "C-Grep 検索結果"
        ],
        "extensions": [
          ".cgrep"
        ]
      }
    ],
    "configurationDefaults": {
      "[cgrep-result]": {
        "editor.bracketPairColorization.enabled": false,
        "editor.guides.bracketPairs": false,
        "editor.matchBrackets": "never"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "c-grep-classifier-sidebar",
          "title": "C-Grep Classifier",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "c-grep-classifier-sidebar": [
        {
          "type": "webview",
          "id": "cGrepClassifierView",
          "name": "データフロー分類結果"
        }
      ]
    },
    "commands": [
      {
        "command": "c-grep-classifier.search",
        "title": "C-Grep: データフロー分類検索を実行"
      },
      {
        "command": "c-grep-classifier.showResultsInEditor",
        "title": "C-Grep: 検索結果をエディタで開く"
      },
      {
        "command": "c-grep-classifier.openResultAtCursor",
        "title": "C-Grep: カーソル行の一致箇所を開く"
      },
      {
        "command": "c-grep-classifier.toggleFunctionSummary",
        "title": "C-Grep: 関数名一覧の表示を切り替え"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "c-grep-classifier.openResultAtCursor",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "c-grep-classifier.search",
        "key": "alt+q",
        "mac": "alt+q",
        "when": "editorTextFocus"
      },
      {
        "command": "c-grep-classifier.openResultAtCursor",
        "key": "enter",
        "when": "editorTextFocus && resourceScheme == 'cgrep-result'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^16.11.7",
    "typescript": "^4.9.5"
  }
}
